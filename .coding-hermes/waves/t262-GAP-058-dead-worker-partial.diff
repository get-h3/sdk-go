+// admitRejection classifies why admitResult refused a delivery. The zero
+// value is admitAccepted, so a caller can switch on the returned class and
+// fall through to the harness callback only on admitAccepted.
+type admitRejection int
+
+const (
+	// admitAccepted: the id passed the GAP-049 comparison and has been
+	// recorded — the caller may run OnResult.
+	admitAccepted admitRejection = iota
+	// admitAlreadyResolved: the id equals the last resolved id — a retry of
+	// an already-applied result (GAP-049's idempotency guard).
+	admitAlreadyResolved
+	// admitMismatch: a decision is in flight and the id is neither that
+	// decision nor a replay of the resolved one — invented or long-stale.
+	admitMismatch
+	// admitUnknownSession: the session is not in the store.
+	admitUnknownSession
+)
+
+// admitResult is the GAP-049 admission gate made atomic (GAP-058): the full id
+// comparison AND, on admit, the recording of the accepted id plus the
+// LastActive/TurnCount bump happen inside ONE write-locked critical section —
+// before the harness callback runs. The previous shape compared ids via
+// snapshot() (RLock) and recorded the accepted id in a separate update() after
+// OnResult, so two concurrent deliveries of the same decision_id could both
+// pass the check and both drive the callback — a double side effect the retry
+// guard exists to prevent.
+//
+// The rule, when a decision IS in flight (CurrentDecisionID != ""):
+//
+//   - decision_id == in-flight            -> admit (the normal path);
+//   - decision_id == last resolved id     -> admitAlreadyResolved;
+//   - anything else                       -> admitMismatch.
+//
+// When NO decision is in flight (CurrentDecisionID == "", e.g. the session was
+// created and the harness has not answered yet) the result is admitted: there
+// is nothing to correlate against, and rejecting it would break the permissive
+// contract for a session with no outstanding work (GAP-049).
+//
+// One deliberate collision ruling: inside the OnResult window the in-flight id
+// and the last resolved id can be the SAME id — the admitted result recorded
+// it as resolved while the loop has not yet recorded the decision OnResult
+// returned. That single id cannot be both "in flight" and "already applied",
+// and the in-flight match wins: a delivery racing the callback through that
+// window is admitted exactly as the pre-GAP-058 code admitted it. For a
+// harness whose returned decision id is always distinct from the delivered one
+// (the documented loop shape) the window is one callback wide, and a
+// re-delivery of the id the session just resolved classifies as
+// admitAlreadyResolved.
+//
+// An admitted delivery whose callback then fails is still resolved: the id was
+// consumed at admission, so a retry is answered "already been resolved"
+// instead of re-running the harness side effect.
+//
+// GAP-028: cancelled is terminal. A cancelled session's delivery is still
+// admitted (harness callbacks are permissive) but the entry is left untouched
+// — no turn bump, no recorded id — so a late result can neither resurrect the
+// lifecycle nor make a later retry compare against state the cancel froze.
+func (s *sessionStore) admitResult(sessionID, decisionID string) admitRejection {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	entry, ok := s.sessions[sessionID]
+	if !ok {
+		return admitUnknownSession
+	}
+	switch {
+	case entry.CurrentDecisionID != "" &&
+		decisionID == entry.LastResultDecisionID &&
+		decisionID != entry.CurrentDecisionID:
+		return admitAlreadyResolved
+	case entry.CurrentDecisionID != "" && decisionID != entry.CurrentDecisionID:
+		return admitMismatch
+	}
+	if entry.Status != "cancelled" {
+		entry.LastActive = time.Now()
+		entry.TurnCount++
+		entry.LastResultDecisionID = decisionID
+	}
+	return admitAccepted
+}
+
