+	switch {
+	case !ok:
 		s.sessions.create(req.SessionID)
+	case entry.Status != "cancelled":
 		s.sessions.update(req.SessionID, func(e *sessionEntry) {
+			// Re-check under the write lock: a cancel that landed between the
+			// snapshot and this update must not have its turn counted
+			// (GAP-028).
+			if e.Status == "cancelled" {
+				return
+			}
 			e.LastActive = time.Now()
 			e.TurnCount++
 		})
