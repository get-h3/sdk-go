+// TestResultEndpoint_SequentialReplayUnchanged (GAP-049 over the GAP-058
+// gate): moving admission under the store write lock must not move the
+// sequential contract — the retry of the just-resolved id is still 400
+// "already been resolved", an invented id is still 400 "does not match the
+// session's in-flight decision", and neither reaches OnResult nor touches
+// session state.
+func TestResultEndpoint_SequentialReplayUnchanged(t *testing.T) {
+	m := newMockHarness()
+	m.onResultDec = &protocol.Decision{
+		Decision:   protocol.DecisionText,
+		DecisionID: "dec-seq-002",
+		Text:       &protocol.TextResp{Content: "applied once", Finished: true},
+	}
+	srv := NewHTTPServer(m)
+	ts := httptest.NewServer(srv)
+	defer ts.Close()
+
+	const sid = "sess-gap058-seq"
+	d1 := postProcess(t, ts, sid)
+	if d1.DecisionID == "" {
+		t.Fatal("POST /v1/process returned an empty decision_id; cannot correlate")
+	}
+
+	// 1. First delivery — accepted, the harness runs once.
+	status, raw := postResult(t, ts, sid, d1.DecisionID, "tool_result")
+	if status != http.StatusOK {
+		t.Fatalf("first delivery: expected 200, got %d (%s)", status, raw)
+	}
+
+	// 2. Retry of the just-resolved id — 400 "already been resolved".
+	status, raw = postResult(t, ts, sid, d1.DecisionID, "tool_result")
+	if status != http.StatusBadRequest {
+		t.Fatalf("replayed delivery: expected 400, got %d (%s)", status, raw)
+	}
+	var errResp protocol.ErrorResponse
+	if err := json.Unmarshal(raw, &errResp); err != nil {
+		t.Fatalf("decode replay error response: %v", err)
+	}
+	if !strings.Contains(errResp.Error.Message, "already been resolved") {
+		t.Errorf("expected 'already been resolved' in message, got %q", errResp.Error.Message)
+	}
+
+	// 3. Invented id — 400 "does not match", naming the in-flight decision.
+	status, raw = postResult(t, ts, sid, "dec-seq-invented", "tool_result")
+	if status != http.StatusBadRequest {
+		t.Fatalf("invented delivery: expected 400, got %d (%s)", status, raw)
+	}
+	if err := json.Unmarshal(raw, &errResp); err != nil {
+		t.Fatalf("decode invented error response: %v", err)
+	}
+	if !strings.Contains(errResp.Error.Message, "does not match the session's in-flight decision") {
+		t.Errorf("expected mismatch message, got %q", errResp.Error.Message)
+	}
+	if !strings.Contains(errResp.Error.Message, "dec-seq-002") {
+		t.Errorf("expected the in-flight decision id to be named, got %q", errResp.Error.Message)
+	}
+
+	// Neither refused delivery drove the harness or counted as a turn.
+	if m.resultCalls != 1 {
+		t.Errorf("expected OnResult to have run exactly once, got %d", m.resultCalls)
+	}
+	sr := getSession(t, ts, sid)
+	if sr.TurnCount != 2 {
+		t.Errorf("expected turn_count 2 (process + accepted result), got %d", sr.TurnCount)
+	}
+	if sr.CurrentDecision != "dec-seq-002" {
+		t.Errorf("expected current_decision dec-seq-002, got %q", sr.CurrentDecision)
+	}
+}
