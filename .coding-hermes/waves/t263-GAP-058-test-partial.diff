+// ---------------------------------------------------------------------------
+// GAP-058 + GAP-059 — session lifecycle continuity and atomic result admission
+// ---------------------------------------------------------------------------
+
+// TestSessionLifecycle_ProcessDoesNotResetContinuingSession (GAP-059): a
+// second POST /v1/process on an EXISTING non-cancelled session must CONTINUE
+// it — turn_count 2, started_at unchanged — not recreate the entry. Pre-fix
+// processHandler called sessions.create() on every process, resetting
+// started_at to now and turn_count to 0 (+1) on each turn of a continuing
+// conversation, contradicting the documented status machine
+// (docs/verification/gap-051-session-status-machine.md).
+func TestSessionLifecycle_ProcessDoesNotResetContinuingSession(t *testing.T) {
+	m := newMockHarness()
+	srv := NewHTTPServer(m)
+	ts := httptest.NewServer(srv)
+	defer ts.Close()
+
+	const sid = "sess-gap059"
+	first := postProcess(t, ts, sid)
+	before := getSession(t, ts, sid)
+	if before.TurnCount != 1 {
+		t.Fatalf("expected turn_count 1 after the first process, got %d", before.TurnCount)
+	}
+
+	second := postProcess(t, ts, sid)
+
+	after := getSession(t, ts, sid)
+	if after.TurnCount != 2 {
+		t.Errorf("expected turn_count 2 after two processes, got %d — the second process reset the session lifecycle", after.TurnCount)
+	}
+	// started_at is compared on the wire (RFC3339): the pre-fix recreate
+	// stamps a fresh time.Now() on every process. The turn_count assertion
+	// above is the deterministic red half; this one pins the started_at half.
+	if after.StartedAt != before.StartedAt {
+		t.Errorf("started_at moved on the second process: %s -> %s — the session was recreated, not continued", before.StartedAt, after.StartedAt)
+	}
+	if second.DecisionID != first.DecisionID {
+		t.Errorf("expected the same canned decision %q from both processes, got %q", first.DecisionID, second.DecisionID)
+	}
+	if after.Status != protocol.SessionActive {
+		t.Errorf("expected status %q, got %q", protocol.SessionActive, after.Status)
+	}
+}
+
+// TestSessionLifecycle_StartedAtPreservedAcrossProcesses (GAP-059, exact
+// half): the RFC3339 comparison above can mask a sub-second recreate, so this
+// twin asserts the exact instant by polling GET within the same second —
+// started_at more than one second old after the second process means the
+// entry was recreated (the pre-fix create() stamps a fresh time.Now()).
+func TestSessionLifecycle_StartedAtPreservedAcrossProcesses(t *testing.T) {
+	m := newMockHarness()
+	srv := NewHTTPServer(m)
+	ts := httptest.NewServer(srv)
+	defer ts.Close()
+
+	const sid = "sess-gap059-startedat"
+	postProcess(t, ts, sid)
+
+	// Once the session exists, started_at must never move again. Sleep past
+	// any sub-second recreate granularity, then process again and check age.
+	time.Sleep(1100 * time.Millisecond)
+	postProcess(t, ts, sid)
+
+	sr := getSession(t, ts, sid)
+	startedAt, err := time.Parse(time.RFC3339, sr.StartedAt)
+	if err != nil {
+		t.Fatalf("parse started_at %q: %v", sr.StartedAt, err)
+	}
+	if age := time.Since(startedAt); age > time.Second {
+		t.Errorf("started_at is only %s old after the second process — the session was recreated with a fresh timestamp instead of continued", age.Round(time.Millisecond))
+	}
+}
+
+// gatedResultHarness lets the admitted result INTO OnResult and holds it
+// there until the test closes `release`. GAP-058 uses it to make the
+// check-then-act admission window observable: pre-fix, duplicates that reach
+// their snapshot admission while the first delivery sits parked inside
+// OnResult all pass (its idempotency record has not landed yet) and park too,
+// so `calls` climbs toward `workers`; post-fix, admission is atomic under the
+// store write lock, so the duplicates are refused while the first is parked
+// and the rejections complete independently of the gate.
+type gatedResultHarness struct {
+	mu      sync.Mutex
+	calls   int
+	release chan struct{}
+}
+
+func newGatedResultHarness() *gatedResultHarness {
+	return &gatedResultHarness{
+		release: make(chan struct{}),
+	}
+}
+
+func (h *gatedResultHarness) snapshotCalls() int {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return h.calls
+}
+
+func (h *gatedResultHarness) OnProcess(req *protocol.ProcessRequest) (*protocol.Decision, error) {
+	return &protocol.Decision{
+		Decision:   protocol.DecisionText,
+		DecisionID: "dec-gated-proc",
+		Text:       &protocol.TextResp{Content: "thinking...", Finished: false},
+	}, nil
+}
+
+func (h *gatedResultHarness) OnResult(req *protocol.ResultRequest) (*protocol.Decision, error) {
+	h.mu.Lock()
+	h.calls++
+	h.mu.Unlock()
+	<-h.release
+	return &protocol.Decision{
+		Decision:   protocol.DecisionText,
+		DecisionID: "dec-gated-next",
+		Text:       &protocol.TextResp{Content: "applied once", Finished: true},
+	}, nil
+}
+
+func (h *gatedResultHarness) OnCancel(req *protocol.CancelRequest) error { return nil }
+
+func (h *gatedResultHarness) OnSessionTerminate(sessionID string) error { return nil }
+
+func (h *gatedResultHarness) Health() *protocol.HealthResponse {
+	return &protocol.HealthResponse{
+		Status:          protocol.HealthOK,
+		Version:         "1.0.0",
+		Transport:       "rest",
+		ProtocolVersion: "1.0",
+	}
+}
+
+// TestResultEndpoint_ConcurrentDuplicateAdmittedOnce (GAP-058): N>=8
+// concurrent deliveries of the SAME in-flight decision_id must produce
+// exactly one 200, the rest 400 "already been resolved", OnResult exactly
+// once, and exactly one recorded turn. Pre-fix the admission check
+// (snapshot, RLock) and the idempotency record (update, write lock) were two
+// critical sections around OnResult, so duplicates arriving while the first
+// delivery is inside OnResult all pass the check — each drove the harness.
+// The gated harness pins that window deterministically: the first admitted
+// delivery parks inside OnResult and every duplicate either passes its check
+// while it is parked (pre-fix: admitted, parked, counted) or is refused
+// atomically (post-fix: 400 without touching the harness).
+// Run under `go test -race -count=1 ./harness/`.
+func TestResultEndpoint_ConcurrentDuplicateAdmittedOnce(t *testing.T) {
+	gh := newGatedResultHarness()
+	srv := NewHTTPServer(gh)
+	ts := httptest.NewServer(srv)
+	defer ts.Close()
+
+	const (
+		sid     = "sess-gap058-race"
+		workers = 12 // >= 8 by acceptance criteria
+	)
+	d1 := postProcess(t, ts, sid)
+	if d1.DecisionID == "" {
+		t.Fatal("POST /v1/process returned an empty decision_id; cannot correlate")
+	}
+
+	type delivery struct {
+		status int
+		body   []byte
+	}
+	deliveries := make(chan delivery, workers)
+	errCh := make(chan error, workers)
+	var wg sync.WaitGroup
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		//nolint:gosec // loop var is captured by value via the parameter.
+		go func(i int) {
+			defer wg.Done()
+			resp, err := http.Post(ts.URL+"/v1/result", "application/json",
+				strings.NewReader(resultJSON(sid, d1.DecisionID)))
+			if err != nil {
+				errCh <- fmt.Errorf("worker %d: POST /v1/result: %w", i, err)
+				return
+			}
+			defer func() { _ = resp.Body.Close() }()
+			raw, err := io.ReadAll(resp.Body)
+			if err != nil {
+				errCh <- fmt.Errorf("worker %d: read POST /v1/result body: %w", i, err)
+				return
+			}
+			deliveries <- delivery{status: resp.StatusCode, body: raw}
+		}(i)
+	}
+
+	// Release the gate only once every delivery has reached a verdict
+	// independent of it: workers-1 refusations (the atomic-admission path)
+	// or `workers` OnResult entries (the pre-fix admitted-through-the-window
+	// path). Waiting for either keeps this deterministic in both worlds —
+	// releasing on the first entry alone would let late duplicates race past
+	// a window that has already closed.
+	tally := make([]delivery, 0, workers)
+	rejected := 0
+	accepted := 0
+	deadline := time.After(10 * time.Second)
+	for gh.snapshotCalls()+rejected < workers {
+		select {
+		case del := <-deliveries:
+			tally = append(tally, del)
+			if del.status == http.StatusBadRequest {
+				rejected++
+			}
+		case <-deadline:
+			close(gh.release)
+			t.Fatal("duplicate deliveries neither resolved nor admitted; admission state inconclusive")
+		default:
+			time.Sleep(100 * time.Microsecond)
+		}
+	}
+	close(gh.release)
+
+	wg.Wait()
+	close(deliveries)
+	close(errCh)
+	for err := range errCh {
+		t.Error(err)
+	}
+	for del := range deliveries {
+		tally = append(tally, del)
+	}
+
+	accepted, rejected = 0, 0
+	for _, del := range tally {
+		switch del.status {
+		case http.StatusOK:
+			accepted++
+		case http.StatusBadRequest:
+			rejected++
+			var errResp protocol.ErrorResponse
+			if err := json.Unmarshal(del.body, &errResp); err != nil {
+				t.Errorf("decode duplicate-rejection body: %v", err)
+			} else if !strings.Contains(errResp.Error.Message, "already been resolved") {
+				t.Errorf("expected 'already been resolved' in the rejection, got %q", errResp.Error.Message)
+			}
+		default:
+			t.Errorf("duplicate delivery got unexpected status %d", del.status)
+		}
+	}
+	if accepted != 1 {
+		t.Errorf("expected exactly 1 accepted (200) delivery, got %d — concurrent duplicates both drove the harness", accepted)
+	}
+	if rejected != workers-1 {
+		t.Errorf("expected %d rejected (400) deliveries, got %d", workers-1, rejected)
+	}
+	if calls := gh.snapshotCalls(); calls != 1 {
+		t.Errorf("expected the OnResult side effect exactly once, got %d", calls)
+	}
+
+	// One turn for the process + ONE for the single admitted result: the
+	// admission bump belongs to the one accepted delivery, not to each
+	// duplicate, and no second bump may run after OnResult.
+	sr := getSession(t, ts, sid)
+	if sr.TurnCount != 2 {
+		t.Errorf("expected turn_count 2 (process + one admitted result), got %d", sr.TurnCount)
+	}
+	if sr.CurrentDecision != "dec-gated-next" {
+		t.Errorf("expected current_decision dec-gated-next, got %q", sr.CurrentDecision)
+	}
+}
