+// concurrentHarness backs TestConcurrentSameSessionRequestsNoRace. GAP-058
+// adaptation: OnProcess callers that arrive while `park` is armed wait on
+// `release`, and the release is fired by the setup goroutine's own admitted
+// result — so no burst process can complete between the setup process
+// (in-flight = "dec-race-proc") and the setup result. Every burst process
+// therefore records its decision while the id is already in flight, i.e.
+// pre-GAP-058 semantics (which the store still grants via the in-flight
+// match, HTTP 200) and post-GAP-058 semantics (admission + record stay
+// consistent) both yield the same turn count deterministically.
 type concurrentHarness struct {
 	mu           sync.Mutex
 	processCalls int
 	resultCalls  int
+	park         bool
+	release      chan struct{}
+}
+
+func newConcurrentHarness() *concurrentHarness {
+	return &concurrentHarness{
+		park:    true,
+		release: make(chan struct{}),
+	}
+}
+
+// waitProcessCalls blocks until n OnProcess calls have arrived and taken
+// their park decision (both under mu, so a caller that is counted has
+// already decided to park).
+func (h *concurrentHarness) waitProcessCalls(n int) {
+	for {
+		h.mu.Lock()
+		got := h.processCalls
+		h.mu.Unlock()
+		if got >= n {
+			return
+		}
+		time.Sleep(100 * time.Microsecond)
+	}
+}
+
+// disarmPark lets future OnProcess calls through without parking. The parked
+// ones are freed when the setup result's admission closes release.
+func (h *concurrentHarness) disarmPark() {
+	h.mu.Lock()
+	h.park = false
+	h.mu.Unlock()
 }
 
